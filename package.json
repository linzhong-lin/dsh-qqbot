{
  "name": "dsh-qqbot",
  "version": "0.13.0",
  "private": true,
  "description": "DeepSeek Harness 的 QQ 频道插件：基于 OpenQQ（OneBot v11）的一对一/群聊桥接，自带 QQ 表情、语音合成发送、「主动搭话」计时器，以及首页侧边栏面板。",
  "type": "module",
  "main": "lib/host.js",
  "exports": {
    ".": "./lib/host.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "icon.svg"
  ],
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.1-rc.2"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "qq",
    "onebot",
    "openqq"
  ],
  "license": "MIT",
  "icon": "icon.svg",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
